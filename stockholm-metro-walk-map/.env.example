# Copy to .env and fill in. Never commit .env.
# Node reads this file via --env-file-if-exists (see package.json scripts).

# ---- Isochrone provider -------------------------------------------------
# "valhalla" (default) or "openrouteservice"
ISOCHRONE_PROVIDER=valhalla

# Valhalla base URL. The default public FOSSGIS instance needs no key but is
# for light, non-commercial use only. For production use a self-hosted
# Valhalla (e.g. http://localhost:8002) or a commercial Valhalla host.
VALHALLA_URL=https://valhalla1.openstreetmap.de
# Optional key, sent as ?api_key=... (e.g. Stadia Maps). Leave empty otherwise.
VALHALLA_API_KEY=

# openrouteservice key (https://openrouteservice.org/dev/#/signup)
ORS_API_KEY=
ORS_URL=https://api.openrouteservice.org

# Minimum milliseconds between provider requests (rate limiting).
ISOCHRONE_MIN_INTERVAL_MS=1100

# ---- TfL Unified API -----------------------------------------------------
# Optional. Anonymous access works for the ~22 requests the topology fetch
# makes; a key raises the limit. https://api-portal.tfl.gov.uk/
TFL_APP_KEY=

# ---- Server --------------------------------------------------------------
PORT=8080
# Set to "true" to allow the running server to compute missing station
# isochrones on demand through /api/isochrone (uses the provider above).
ENABLE_ON_DEMAND_ISOCHRONES=false
# Max on-demand isochrone requests per client IP per minute.
RATE_LIMIT_PER_MINUTE=10

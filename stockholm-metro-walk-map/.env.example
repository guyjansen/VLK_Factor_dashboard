# Copy to .env and fill in. Never commit .env. Placeholders only.
# Node reads this file via --env-file-if-exists (see package.json scripts).

# ---- Operator topology (Trafiklab / Samtrafiken GTFS Regional) -----------
# Free key from https://www.trafiklab.se/ (API "GTFS Regional"; Bronze level
# allows 50 downloads a month). Used only by `npm run fetch-topology`, sent as
# ?key=..., never written to disk or logs.
TRAFIKLAB_API_KEY=your-trafiklab-gtfs-regional-key

# Optional Overpass endpoint for the OpenStreetMap station cross-check.
OVERPASS_URL=https://overpass-api.de/api/interpreter

# ---- Isochrone provider -------------------------------------------------
# "valhalla" (default) or "openrouteservice"
ISOCHRONE_PROVIDER=valhalla
# Public FOSSGIS instance: light, non-commercial use only. For production
# self-host Valhalla (e.g. http://localhost:8002) or use a commercial host.
VALHALLA_URL=https://valhalla1.openstreetmap.de
# Optional key, sent as ?api_key=... (e.g. a commercial Valhalla host).
VALHALLA_API_KEY=
# openrouteservice key (https://openrouteservice.org/dev/#/signup)
ORS_API_KEY=your-openrouteservice-key
ORS_URL=https://api.openrouteservice.org
# Minimum milliseconds between provider requests (rate limiting).
ISOCHRONE_MIN_INTERVAL_MS=1100

# ---- Geocoder -------------------------------------------------------------
# Nominatim usage policy: ≤ 1 request/s, identifying User-Agent, cache results.
NOMINATIM_URL=https://nominatim.openstreetmap.org

# ---- Server --------------------------------------------------------------
PORT=8080
# "true" lets the running server compute missing station isochrones on demand
# through /api/isochrone (known station ids only; rate limited).
ENABLE_ON_DEMAND_ISOCHRONES=false
RATE_LIMIT_PER_MINUTE=10
